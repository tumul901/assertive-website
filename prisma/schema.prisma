generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Lead {
  id        Int      @id @default(autoincrement())
  source    String
  name      String?
  email     String?
  phone     String?
  eventType String?
  message   String?
  createdAt DateTime @default(now())
}
